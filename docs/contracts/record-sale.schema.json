{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CRM RecordSale domain input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_key",
    "customer_id",
    "items"
  ],
  "properties": {
    "request_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "customer_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "quantity",
          "expected_unit_price"
        ],
        "properties": {
          "product_id": {
            "$ref": "#/$defs/id"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "expected_unit_price": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,7})\\.[0-9]{2}$"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "description": "Also validate <=18446744073709551615 on the server; never cast through JS Number."
    }
  }
}
